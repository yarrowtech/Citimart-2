{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "create-react-app",
      "buildCommand": "CI=false npm run build"
    },
    "citimart-backend": {
      "root": "citimart-backend",
      "framework": "flask",
      "bindings": [
        { "type": "service", "service": "citimart-recommender", "format": "url", "env": "RECOMMENDER_URL" }
      ]
    },
    "citimart-recommender": {
      "root": "citimart-recommender",
      "runtime": "python",
      "entrypoint": "app.py"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
