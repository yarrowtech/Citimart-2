# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database (required — app fails to start without this) ---
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/citimart_db

# --- Auth (required — app fails to start without this) ---
JWT_SECRET_KEY=replace-with-a-long-random-secret

# --- CORS (production: set to your real frontend domain(s), comma-separated) ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Server ---
FLASK_DEBUG=false
PORT=5000
FRONTEND_URL=http://localhost:3000

# --- Email (password reset, invitations, guest capture) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-sending-address@example.com
EMAIL_HOST_PASSWORD=your-smtp-app-password

# --- Cloudinary (product/media image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- One-time use only: python create_admin.py, not read by the running server ---
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=set-a-strong-password
